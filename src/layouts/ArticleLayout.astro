---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../lib/url";

type Props = {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
};
---

<BaseLayout title={Astro.props.title} description={Astro.props.description}>
  <article class="article">
    <header class="article-header">
      <p class="date">{Astro.props.date.toISOString().slice(0, 10)}</p>
      <h1>{Astro.props.title}</h1>
      <p>{Astro.props.description}</p>
      {Astro.props.tags?.length ? (
        <div class="tags">
          {Astro.props.tags.map((tag) => <a href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>)}
        </div>
      ) : null}
    </header>
    <div class="prose">
      <slot />
    </div>
    <section class="comments" aria-label="评论">
      <h2>评论</h2>
      <script
        src="https://giscus.app/client.js"
        data-repo="wangyong-chengdu/feishu-astro-personal-site"
        data-repo-id="R_kgDOSxz0SA"
        data-category="General"
        data-category-id="DIC_kwDOSxz0SM4C-k4G"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme="preferred_color_scheme"
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      ></script>
    </section>
  </article>
</BaseLayout>
